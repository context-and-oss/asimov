<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Shared metadata for every NuGet package under packages/. -->
  <PropertyGroup Label="Package metadata">
    <Authors>Context&amp;</Authors>
    <Company>Context&amp;</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/context-and-oss/asimov</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/context-and-oss/asimov</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
