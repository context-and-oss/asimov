# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# Backup / scratch
*.bak
*.tmp
*.orig

# Raw image media (per D101 template ground rule —
# only promoted+renamed images get committed)
documentation/**/images/_raw/

# asimov-design review notes — a disposable cache the next design run consumes and
# deletes (d101-feature-design-definition §4.10, D101-design-stage.html R10–R11). Not a design
# artifact; committing it would duplicate a PR's own review thread.
documentation/features/*.review.md

# Asimov working state — the Spec stage's plans (.asimov/plans/), the S101, S102s and
# ledger it renders to (.asimov/specs/), the run log the hooks write (.asimov/log/).
# Working state, never a record; the code and the D101 are what is committed
# (asimov-plan-definition.md §6, s101-ledger-definition.md §7). specs/ under this
# repo root holds the risk log's plan from before 2026-11-17, kept as history.
.asimov/
# Claude Code local state
.claude/settings.local.json

# SDD working directory (ledger, task briefs, large diff files)
.superpowers/

# SDD specs and plans — working documents that drive a change, not toolkit
# content. They belong to the session that produced them, not to the repo.
docs/superpowers/

# .NET packages under packages/ — build output and the local feed verify.sh packs into
bin/
obj/
packages/.local-feed/
packages/out/
packages/.sample-packages/
packages/test/Asimov.Conventions.Sample/.editorconfig

# OpenCode package install (the plugin is plain JS, no dependencies; a local npm install leaves this behind)
node_modules/
package-lock.json
